# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. NEVER put real secrets in this file.

# start.gg developer token (server-only). Create at start.gg > Developer Settings.
STARTGG_API_TOKEN=

# start.gg OAuth app (for "Link start.gg"): start.gg > Developer Settings > OAuth Applications.
# Redirect URL: http://localhost:3000/link/startgg/callback. Secret is server-only.
STARTGG_CLIENT_ID=
STARTGG_CLIENT_SECRET=

# Supabase: Project Settings > API Keys.
# URL + publishable key are safe in the browser; the secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# parry.gg API key (parry.gg > avatar > API Keys). Server-only.
PARRYGG_API_KEY=

# Twitch app keys (dev.twitch.tv/console/apps). Server-only. Used for Reels and set VODs.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube Data API key (console.cloud.google.com > APIs & Services > Credentials). Server-only.
# Optional: adds YouTube Shorts to Reels. Restrict it to "YouTube Data API v3" in Google Cloud.
YOUTUBE_API_KEY=

# Google Cloud Vision API key (same Google Cloud project; needs billing turned on). Server-only.
# Checks every uploaded post photo for adult/gory content. Without it, photo uploads are off.
# Can be the same key as YOUTUBE_API_KEY if that key is allowed to use "Cloud Vision API".
GOOGLE_VISION_API_KEY=

# Password for the scheduled refresh job (/api/cron/refresh). Any long random string. Server-only.
CRON_SECRET=

# The site's public address, used in link previews (e.g. https://smashy.gg). Optional: on Vercel it's
# picked up automatically; locally it falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Public contact email (/privacy, /terms, suspended-account message). Optional: defaults to smashy.help@gmail.com.
NEXT_PUBLIC_CONTACT_EMAIL=

# Set to 1 once sign-in emails go through your own mail setup (docs/launch-checklist.md, step 2).
# Until then the sign-in page recommends Discord.
NEXT_PUBLIC_EMAIL_SIGNIN_READY=

# Notifications in the store apps (apps/mobile, docs/store-apps-plan.md). Server-only secrets.
# Android: base64 of the Firebase service-account JSON file.
FIREBASE_SERVICE_ACCOUNT=
# iPhone: the Apple push key (.p8) as base64 of the file (or the file's text), and the key's 10-character ID.
APNS_KEY=
APNS_KEY_ID=

# A sign-in for App Store and Google Play reviewers, who can't read Smashy's sign-in emails. The one
# address in REVIEW_EMAIL signs in with REVIEW_CODE (exactly 10 digits, a secret) and gets no email.
# Leave both empty to turn it off. Server-only.
REVIEW_EMAIL=
REVIEW_CODE=

# Sign in with Apple: a key made under Certificates, IDs & Profiles → Keys with "Sign in with Apple"
# (primary App ID gg.smashy.ios). Lets deleting an account cancel the person's Apple link. Server-only
# secret: base64 of the .p8 file (or its text), and the key's 10-character ID.
APPLE_SIGNIN_KEY=
APPLE_SIGNIN_KEY_ID=
